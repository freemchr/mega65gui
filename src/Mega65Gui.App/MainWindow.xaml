<Window x:Class="Mega65Gui.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEGA65 GUI" Icon="/Assets/app.ico" Width="1120" Height="720" MinWidth="860" MinHeight="560" FontSize="13"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <DockPanel>
        <!-- ===== Sidebar ===== -->
        <Border DockPanel.Dock="Left" Width="208" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,0">
                <!-- Brand -->
                <Image DockPanel.Dock="Top" Source="/Assets/logo.png" Margin="4,16,4,14" Height="62" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="MEGA65 GUI"/>

                <!-- Footer: device, tools, account (always visible) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,12" DataContext="{Binding Shell}">
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource FlatRow}" Command="{Binding OpenDeviceCommand}" Margin="0,0,0,2"
                            ToolTip="Device connection. Click to open the Device page.">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource Dot}">
                                    <Setter Property="Fill" Value="#8A8A8A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeviceConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource M65Green}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding DeviceText}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                    </StackPanel>
                    </Button>
                    <!-- Device tools: status when installed, an install action when not -->
                    <Button Style="{StaticResource FlatRow}" Command="{Binding OpenToolsCommand}" Margin="0,0,0,8"
                            ToolTip="The official MEGA65 command-line tools used by the Device page. Click to manage."
                            Visibility="{Binding ToolsInstalled, Converter={StaticResource BoolToVisible}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource M65Green}"/>
                            <TextBlock Text="{Binding ToolsText}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding ToolsInstalled, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding InstallToolsCommand}"
                                IsEnabled="{Binding InstallingTools, Converter={StaticResource Not}}"
                                ToolTip="Downloads the official MEGA65 command-line tools (m65, mega65_ftp, etherload) from the Filehost. The Device page needs them.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource M65Orange}"/>
                                <TextBlock Text="Install device tools" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="True" Height="2" Margin="0,4,0,0" Visibility="{Binding InstallingTools, Converter={StaticResource BoolToVisible}}"/>
                        <TextBlock Text="{Binding InstallProgress}" FontSize="11" Margin="2,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding InstallProgress, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>

                    <!-- Account card -->
                    <Border CornerRadius="6" Padding="8,8,4,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" ToolTip="{Binding AccountTooltip}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDefaultBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource M65Blue}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AccountDetail}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding SignOutCommand}" ToolTip="Sign out" Padding="6" MinWidth="0" MinHeight="0"
                                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="&#xF3B1;" Style="{StaticResource Icon}" FontSize="13"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Margin="0,6,4,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>
                            <Button Content="Sign in" Margin="0,8,4,0" HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}"
                                    Command="{Binding SignInCommand}"
                                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation -->
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Width="26"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <ContentControl Content="{Binding Selected}" Margin="22,16,22,10"/>
    </DockPanel>
</Window>
