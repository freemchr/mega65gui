<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Mega65Gui.App.ViewModels"
                    xmlns:v="clr-namespace:Mega65Gui.App.Views">

    <!-- Busy bar + status line shared by every page -->
    <DataTemplate x:Key="StatusFooter">
        <StackPanel Margin="0,6,0,0">
            <ProgressBar IsIndeterminate="True" Height="2" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ================= Update My MEGA65 ================= -->
    <DataTemplate DataType="{x:Type vm:UpdateViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Update My MEGA65" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Finds the right official release, updates your SD card with your approval, backs up what it replaces and guides the core install."/>
                <Expander Header="How to use this page" Style="{StaticResource PageHelp}">
                    <StackPanel Margin="24,6,0,0" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="What it does"/><Run Text=' – Brings your MEGA65 up to the latest official release: the core (the FPGA "hardware"), the ROM and the system files on the SD card.'/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Model"/><Run Text=" – Leave on Auto to read it from the MEGA65 over USB, or pick it if the MEGA65 is not connected."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="SD card"/><Run Text=' – "In the MEGA65" updates the card while it stays in the machine (needs the USB cable). "In a PC card reader" updates a card you have put into this PC.'/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Include the closed ROM"/><Run Text=" – The MEGA65 ROM is only available to owners. Tick it, and sign in with your Filehost account, to update the ROM too."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Update My MEGA65"/><Run Text=" – Runs the 12 steps below. Nothing on the card changes until you approve the list of changes; replaced files are backed up first."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="The core"/><Run Text=" – Installing a core into flash is done on the MEGA65 itself (MEGAFLASH). The update copies the core to the card and tells you exactly what to press."/></TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Model" Style="{StaticResource Label}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Label"/>
                    <TextBlock Grid.Column="3" Text="SD card" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Column="4" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="In the MEGA65" IsChecked="{Binding CardInDevice}" Margin="0,0,16,0" MinWidth="0"
                                     ToolTip="Update the card inside the MEGA65 over the USB/JTAG or Ethernet connection. The MEGA65 resets after each card operation."/>
                        <RadioButton Content="In a PC card reader" IsChecked="{Binding CardInDevice, Converter={StaticResource Not}}" MinWidth="0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.ColumnSpan="6" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CardInDevice}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBox Text="{Binding SdCardPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" ToolTip="The card's drive or a folder with a copy of it"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Browse…" Command="{Binding BrowseSdCardCommand}" Margin="0,0,6,0"/>
                            <Button Content="Eject" Command="{Binding EjectCardCommand}" ToolTip="Safely eject the SD card from this PC's card reader"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="6" Margin="0,8,0,0" Style="{StaticResource Muted}"
                               Text="The card inside the MEGA65 is updated over the connection: its files are backed up to this PC first, only approved changes are uploaded, and every upload is read back and checked."
                               Visibility="{Binding CardInDevice, Converter={StaticResource BoolToVisible}}"/>

                    <DockPanel Grid.Row="2" Grid.ColumnSpan="6" Margin="0,8,0,0">
                        <!-- Inline connect when not connected -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                            <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" MinWidth="100" Margin="0,0,6,0"
                                      ToolTip="The MEGA65's USB/JTAG port"/>
                            <Button Command="{Binding RefreshPortsCommand}" ToolTip="Refresh ports" Margin="0,0,6,0">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                            </Button>
                            <Button Content="Connect" Command="{Binding ConnectCommand}"/>
                        </StackPanel>
                        <Ellipse VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource Dot}">
                                    <Setter Property="Fill" Value="#8A8A8A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource M65Green}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Grid.Row="3" Grid.ColumnSpan="6" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Open report" Command="{Binding OpenReportCommand}" Margin="0,0,6,0"
                                    Visibility="{Binding ReportPath, Converter={StaticResource NullToCollapsed}}"/>
                            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>
                            <Button Style="{DynamicResource AccentButtonStyle}" Padding="16,5"
                                    Command="{Binding RunCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="Update My MEGA65" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding IncludeRom}" VerticalAlignment="Center">
                            <TextBlock TextWrapping="Wrap">Include the closed MEGA65 ROM <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Text="(needs Filehost sign-in and your redeemed ownership code)"/></TextBlock>
                        </CheckBox>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="6" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- Right margin keeps the status labels clear of the overlay scrollbar -->
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,16,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top" HorizontalAlignment="Left"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                        <TextBlock Text="{Binding Number}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,1,0,0"
                                                   Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Status, Converter={StaticResource EnumLabel}}" FontSize="12"
                                               VerticalAlignment="Top" Margin="12,1,4,0"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Filehost catalogue ================= -->
    <DataTemplate DataType="{x:Type vm:CatalogueViewModel}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="MEGA65 File Host" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding CacheInfo}" Style="{StaticResource Muted}"/>
                </StackPanel>
                <Grid Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="28,4,8,4" ToolTip="Search titles, authors and tags"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="10,0,0,0" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="3" Content="Official" IsChecked="{Binding OfficialOnly}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Grid.Column="4" Command="{Binding RefreshCommand}" CommandParameter="{x:Static vm:Flags.True}" ToolTip="Refresh from the Filehost" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                </Button>
            </Grid>
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="11*" MinWidth="240"/><ColumnDefinition Width="10"/><ColumnDefinition Width="9*" MinWidth="260"/></Grid.ColumnDefinitions>
                <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize the list and the details"/>
                <Border Style="{StaticResource Card}" Padding="2" Margin="0">
                    <ListView ItemContainerStyle="{StaticResource CompactRow}" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedFile}" BorderThickness="0" Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Title" Width="182">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Category" Width="80" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Author" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Author}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Updated" Width="82" DisplayMemberBinding="{Binding Updated, StringFormat=d}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding ViewingFileId, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="Select a file to see details and versions" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <DockPanel Visibility="{Binding ViewingFileId, Converter={StaticResource NullToCollapsed}}">
                            <!-- Actions pinned to the bottom of the pane -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <ProgressBar Value="{Binding DownloadPercent}" Height="2" Maximum="100" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding DownloadCommand}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Download"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Show in folder" Command="{Binding ShowInFolderCommand}" Margin="0,0,6,0"
                                            Visibility="{Binding SelectedVersion.CachedPath, Converter={StaticResource NullToCollapsed}}"/>
                                    <Button Content="Open on website" Command="{Binding OpenOnWebsiteCommand}"/>
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Detail.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,8"
                                               Visibility="{Binding Detail.IsAvailable, Converter={StaticResource BoolToVisible}}">
                                        <Run Text="{Binding Detail.Category}"/> · <Run Text="{Binding Detail.Type}"/> · <Run Text="{Binding Detail.Author}"/> · <Run Text="{Binding Detail.Downloads}"/> downloads
                                    </TextBlock>
                                    <TextBlock v:FilehostText.Text="{Binding Detail.Description}" TextWrapping="Wrap" FontSize="12.5" MaxHeight="220"/>

                                    <StackPanel Visibility="{Binding LinkedFiles.Count, Converter={StaticResource NullToCollapsed}}" Margin="0,10,0,0">
                                        <TextBlock Text="Linked files" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding LinkedFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button HorizontalAlignment="Left" Margin="0,0,0,4"
                                                            Command="{Binding DataContext.OpenLinkedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding Versions.Count, Converter={StaticResource NullToCollapsed}}" Margin="0,10,0,0">
                                        <TextBlock Text="Versions" Style="{StaticResource SectionTitle}"/>
                                        <ListView ItemContainerStyle="{StaticResource CompactRow}" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" MaxHeight="200">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Release" Width="70" DisplayMemberBinding="{Binding Release}"/>
                                                    <GridViewColumn Header="File" Width="185">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate><TextBlock Text="{Binding Row.FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Row.FileName}"/></DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Published" Width="88" DisplayMemberBinding="{Binding Row.Published}"/>
                                                    <GridViewColumn Header="" Width="28">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource M65Green}" ToolTip="Current version">
                                                                    <TextBlock.Visibility>
                                                                        <Binding Path="Row.IsActive" Converter="{StaticResource BoolToVisible}"/>
                                                                    </TextBlock.Visibility>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <TextBlock Text="{Binding SelectedVersion.Row.Comment}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!-- ================= MEGA65 File Host Upload ================= -->
    <DataTemplate DataType="{x:Type vm:MyUploadsViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="MEGA65 File Host Upload" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Your own files on the Filehost: upload a new file or a new version, edit its details, or link it to GitHub so new releases are uploaded for you."/>
                <Expander Header="How to use this page" Style="{StaticResource PageHelp}">
                    <StackPanel Margin="24,6,0,0" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="What it is"/><Run Text=" – The same as My File Uploads on files.mega65.org, for developers who publish cores, ROMs and programs. Sign in with your Filehost account first."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Start with the task"/><Run Text=" – First choose what you want to do: upload a new file, upload a new version, or edit details. The page then only shows what that task needs, and the heading names the file it works on."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="New version"/><Run Text=" – Choose the file on the left, choose the new file, check the version number and press Upload version. Create new version adds it and makes it active; Replace latest version deletes the latest one."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="New file"/><Run Text=" – Choose the file to upload (or fill it from GitHub), fill in title, type, description, platform and access, then press Upload new file."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Details"/><Run Text=" – Change the attributes and press Save details. They are also saved with every upload, as on the website."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Fill from GitHub"/><Run Text=" – Paste a repository link and press Fill from GitHub: the newest release file is downloaded and the title, description, search tags, version and comment are filled in from GitHub. Check them, then upload."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="GitHub link"/><Run Text=" – Link a file to its GitHub repository and the release file to use (such as MegaST-*.zip). Sync uploads the newest release as a new version if it is not on the Filehost yet. The version number is taken from the tag (v1.2 becomes 1.2)."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Safety"/><Run Text=" – Nothing is uploaded or changed on the Filehost until you confirm it. Previews, deleting files and versions, and choosing the active version are done on the website."/></TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
            <ProgressBar DockPanel.Dock="Bottom" Height="4" Maximum="100" Value="{Binding UploadPercent}" Margin="0,6,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AccountText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Sign in…" Command="{Binding SignInCommand}" Style="{DynamicResource AccentButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- The task bar: say what you want to do first, so nothing acts on a file by accident -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisible}}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Content="Change task" Command="{Binding ChangeTaskCommand}" Margin="6,0,0,0"
                                Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>
                        <Button Command="{Binding RefreshCommand}" ToolTip="Reload your files from the Filehost" Margin="6,0,0,0">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding TaskHeading}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <Grid IsEnabled="{Binding IsSignedIn}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <DockPanel Width="260" Margin="0,0,10,0" Visibility="{Binding ShowFileList, Converter={StaticResource BoolToVisible}}">
                    <TextBlock DockPanel.Dock="Top" Text="Choose the file" Style="{StaticResource SectionTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Your files on the Filehost."/>
                    <Border Style="{StaticResource Card}" Padding="2" Margin="0">
                        <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" DisplayMemberPath="DisplayTitle" BorderThickness="0" Background="Transparent"/>
                    </Border>
                </DockPanel>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <!-- Choose a task -->
                        <StackPanel Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVisible}}" MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Upload a new file" Command="{Binding NewFileCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="190" VerticalAlignment="Center"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Upload a new file" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Publish something that is not on the Filehost yet, such as a new core. Fill it in yourself or from a GitHub release."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Upload a new version" Command="{Binding StartNewVersionCommand}" MinWidth="190" VerticalAlignment="Center"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Upload a new version of one of your files" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Add a newer release to a file you already published. You choose the file next."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Edit details" Command="{Binding StartEditDetailsCommand}" MinWidth="190" VerticalAlignment="Center"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Edit the details of one of your files" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Change the title, description, platform, access and the other attributes, or its GitHub link. Nothing is uploaded."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Sync from GitHub" Command="{Binding SyncAllCommand}" MinWidth="190" VerticalAlignment="Center"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Upload new GitHub releases" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="For every file linked to GitHub, uploads the newest release as a new version if it is not on the Filehost yet. You are asked first."/>
                                        <CheckBox Content="Check GitHub when MEGA65 GUI starts" IsChecked="{Binding CheckAtStartup}" Margin="0,6,0,0"
                                                  ToolTip="Needs a remembered password. You are still asked before anything is uploaded."/>
                                        <TextBlock Text="{Binding GitHubTokenInfo}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="GitHub token…" Command="{Binding SetGitHubTokenCommand}" Margin="0,0,6,0"/>
                                            <Button Content="Remove token" Command="{Binding RemoveGitHubTokenCommand}"
                                                    Visibility="{Binding HasGitHubToken, Converter={StaticResource BoolToVisible}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Choose a file on the left."
                                   Visibility="{Binding NeedsFileChoice, Converter={StaticResource BoolToVisible}}"/>

                        <!-- Upload -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding ShowUpload, Converter={StaticResource BoolToVisible}}">
                            <StackPanel>
                                <TextBlock Text="File to upload" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="GitHub" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <TextBox Grid.Column="1" Text="{Binding GitHubRepo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"
                                             ToolTip="Optional: https://github.com/owner/repo. Fill from GitHub takes the newest release and fills in this page."/>
                                    <Button Grid.Column="2" Content="Fill from GitHub" Command="{Binding FillFromGitHubCommand}" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Text="Release file" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBox Text="{Binding AssetPattern, UpdateSourceTrigger=PropertyChanged}" Width="240"
                                                 ToolTip="Which file of the release to upload, with * and ?, e.g. MegaST-v*.zip. Empty takes the first file the Filehost accepts."/>
                                        <CheckBox Content="Include pre-releases" IsChecked="{Binding IncludePrereleases}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <Button Content="GitHub token…" Command="{Binding SetGitHubTokenCommand}" Margin="12,0,0,0" ToolTip="{Binding GitHubTokenInfo}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <Button Content="Choose file…" Command="{Binding BrowseFileCommand}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding UploadInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsNewFile, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Version" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding VersionNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 to 9999.9, one decimal place"/>
                                        <TextBlock Grid.Column="2" Text="Comment" Style="{StaticResource Label}" Margin="14,0,8,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding VersionComment, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" ToolTip="Optional version comment"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton Content="Create new version" IsChecked="{Binding ReplaceLatest, Converter={StaticResource Not}}" Margin="0,0,16,0" GroupName="VersionMode"/>
                                        <RadioButton Content="Replace latest version" IsChecked="{Binding ReplaceLatest}" GroupName="VersionMode"
                                                     ToolTip="Deletes the latest uploaded version"/>
                                    </StackPanel>
                                    <Button Content="Upload version" Command="{Binding UploadVersionCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Button Content="Upload new file" Command="{Binding UploadNewFileCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left"
                                        Visibility="{Binding IsNewFile, Converter={StaticResource BoolToVisible}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Attributes -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding ShowAttributes, Converter={StaticResource BoolToVisible}}">
                            <StackPanel>
                                <TextBlock Text="File attributes" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="This file is locked by the Filehost admins and is not visible in public." Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisible}}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Title" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <TextBox Grid.Column="1" Text="{Binding FileTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,6" ToolTip="Display name, can differ from the file name"/>
                                    <TextBlock Grid.Row="1" Text="Type" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FileTypes}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="2" Text="Description" Style="{StaticResource Label}" Margin="0,4,10,6" VerticalAlignment="Top"/>
                                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <!-- The website's only formatting codes, so #bs# and #be# do not look like a fault -->
                                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" VerticalAlignment="Top">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <TextBlock Grid.ColumnSpan="2" Text="Formatting on the website" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                                <TextBlock Grid.Row="1" Text="You type" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,10,2"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Website shows" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,2"/>
                                                <TextBlock Grid.Row="2" Text="#bs#text#be#" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,0,10,3"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="text (bold)" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                                                <TextBlock Grid.Row="3" Text="new line" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,0,10,3"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="new line" FontSize="11.5" Margin="0,0,0,3"/>
                                                <TextBlock Grid.Row="4" Text="https://…" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="a link" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="11.5"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="Nothing else is formatted: Markdown such as **, # or tables shows as typed."/>
                                        <TextBox Grid.Column="2" Grid.RowSpan="2" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="65000" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="160" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                                 ToolTip="What users see. Put #bs# and #be# around bold text."/>
                                    </Grid>
                                    <Expander Grid.Row="3" Grid.Column="1" Header="Website Preview" IsExpanded="True" Margin="0,0,0,8"
                                              ToolTip="The description as files.mega65.org will show it">
                                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                <TextBlock v:FilehostText.Text="{Binding Description}" TextWrapping="Wrap" FontSize="12.5"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Expander>
                                    <TextBlock Grid.Row="4" Text="Search tags" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Suggest from GitHub" Command="{Binding SuggestTagsCommand}" Margin="6,0,0,0"
                                                    ToolTip="Suggests tags from the GitHub repository: its topics, name, description and release notes"/>
                                            <TextBox Text="{Binding SearchTags, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                                     ToolTip="Optional: tags of at least 3 characters, separated by commas. Title, file name, type, platform and author are already searched."/>
                                        </DockPanel>
                                        <WrapPanel Margin="0,6,0,0" Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVisible}}">
                                            <TextBlock Text="Suggested:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                            <ItemsControl ItemsSource="{Binding SuggestedTags}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                Padding="8,2" Margin="0,0,4,4" FontSize="12" ToolTip="Add this tag">
                                                            <TextBlock><Run Text="+ "/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="Add all" Command="{Binding AddAllTagsCommand}" Padding="8,2" Margin="4,0,0,4" FontSize="12"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="5" Text="Short link" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ShortLink, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,0,0,6" Width="220" HorizontalAlignment="Left"
                                             ToolTip="Optional: letters, digits and '-', 1 to 20 characters"/>
                                    <TextBlock Grid.Row="6" Text="Video mode" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <WrapPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,6">
                                        <CheckBox Content="PAL" IsChecked="{Binding Pal}" Margin="0,0,14,0"/>
                                        <CheckBox Content="NTSC" IsChecked="{Binding Ntsc}"/>
                                    </WrapPanel>
                                    <TextBlock Grid.Row="7" Text="Platform" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <WrapPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,6">
                                        <CheckBox Content="MEGA65" IsChecked="{Binding OsMega65}" Margin="0,0,14,4"/>
                                        <CheckBox Content="C65" IsChecked="{Binding OsC65}" Margin="0,0,14,4"/>
                                        <CheckBox Content="C64" IsChecked="{Binding OsC64}" Margin="0,0,14,4"/>
                                        <CheckBox Content="Vixen" IsChecked="{Binding OsVixen}" Margin="0,0,14,4"/>
                                        <CheckBox Content="Windows" IsChecked="{Binding OsWindows}" Margin="0,0,14,4"/>
                                        <CheckBox Content="macOS" IsChecked="{Binding OsMac}" Margin="0,0,14,4"/>
                                        <CheckBox Content="Linux" IsChecked="{Binding OsLinux}" Margin="0,0,14,4"/>
                                        <CheckBox Content="Online" IsChecked="{Binding OsOnline}" Margin="0,0,14,4"/>
                                    </WrapPanel>
                                    <TextBlock Grid.Row="8" Text="Access" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding AccessOptions}" SelectedItem="{Binding Access}" Width="220" HorizontalAlignment="Left" Margin="0,0,0,6">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding Hint}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="9" Text="Core version" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding CoreVersions}" SelectedItem="{Binding CoreVersion}" DisplayMemberPath="VersionText" Margin="0,0,0,6"
                                              ToolTip="Optional: the core this file was made for or needs"/>
                                    <TextBlock Grid.Row="10" Text="ROM version" Style="{StaticResource Label}" Margin="0,0,10,6" Visibility="{Binding ShowRomVersion, Converter={StaticResource BoolToVisible}}"/>
                                    <ComboBox Grid.Row="10" Grid.Column="1" ItemsSource="{Binding RomVersions}" SelectedItem="{Binding RomVersion}" DisplayMemberPath="Label" Margin="0,0,0,6"
                                              Visibility="{Binding ShowRomVersion, Converter={StaticResource BoolToVisible}}"/>
                                    <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                        <CheckBox Content="Permission for Intro Disk" IsChecked="{Binding IntroDisk}" Margin="0,0,0,4"
                                                  ToolTip="Allow the MEGA65 team to include this file, unmodified, on community disks, which anyone may redistribute"/>
                                        <CheckBox Content="Highscore submission" IsChecked="{Binding HighScore}" Margin="0,0,0,4"
                                                  Visibility="{Binding IsGame, Converter={StaticResource BoolToVisible}}"
                                                  ToolTip="Shows a Top Ten list on the file page. You accept or reject scores in Messages on the website."/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Save details" Command="{Binding SaveDetailsCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,0"
                                            Visibility="{Binding IsEditDetails, Converter={StaticResource BoolToVisible}}"/>
                                    <Button Content="Open on website" Command="{Binding OpenOnWebsiteCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Previews -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding ShowFileInfo, Converter={StaticResource BoolToVisible}}">
                            <StackPanel>
                                <TextBlock Text="Previews" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding PreviewInfo}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Previews}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,10,10" Width="150">
                                                <Button Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        Padding="0" Height="100" ToolTip="Open the full preview">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Kind}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                                        <Image Source="{Binding ThumbnailUri}" Stretch="Uniform"/>
                                                    </Grid>
                                                </Button>
                                                <Button Content="Delete" Command="{Binding DataContext.DeletePreviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch" Margin="0,4,0,0" FontSize="12" Padding="4,2"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel IsEnabled="{Binding CanAddPreview}">
                                    <Button DockPanel.Dock="Left" Content="Add pictures…" Command="{Binding AddPreviewsCommand}" Margin="0,0,12,0"
                                            ToolTip="Upload screenshots, a video or audio as previews (several at once)"/>
                                    <Button DockPanel.Dock="Right" Content="Add link" Command="{Binding AddVideoLinkCommand}" Margin="6,0,0,0"/>
                                    <TextBox Text="{Binding VideoLink, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" ToolTip="Or paste a link to a video, for example on YouTube"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- GitHub -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding ShowFileInfo, Converter={StaticResource BoolToVisible}}">
                            <StackPanel>
                                <TextBlock Text="GitHub link" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Once linked, Sync uploads each new GitHub release of this project as a new version of this file."/>
                                <Grid Visibility="{Binding IsEditDetails, Converter={StaticResource BoolToVisible}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Repository" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <TextBox Grid.Column="1" Text="{Binding GitHubRepo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="https://github.com/owner/repo or owner/repo"/>
                                    <TextBlock Grid.Row="1" Text="Release file" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AssetPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="260" HorizontalAlignment="Left"
                                             ToolTip="Which file of the release to upload, with * and ?, e.g. MegaST-v*.zip"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" Content="Include pre-releases" IsChecked="{Binding IncludePrereleases}" Margin="0,0,0,6"/>
                                </Grid>
                                <TextBlock Text="{Binding LinkInfo}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                <WrapPanel>
                                    <Button Content="Save link" Command="{Binding SaveLinkCommand}" Margin="0,0,6,6"/>
                                    <Button Content="Sync from GitHub" Command="{Binding SyncSelectedCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,6"
                                            ToolTip="Upload the newest release as a new version, if it is not on the Filehost yet"/>
                                    <Button Content="Remove link" Command="{Binding RemoveLinkCommand}" Margin="0,0,6,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Versions -->
                        <Border Style="{StaticResource Card}" Padding="2" Visibility="{Binding ShowFileInfo, Converter={StaticResource BoolToVisible}}">
                            <ListView ItemsSource="{Binding Versions}" ItemContainerStyle="{StaticResource CompactRow}" BorderThickness="0" Background="Transparent" MaxHeight="260">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Version" Width="70" DisplayMemberBinding="{Binding Version}"/>
                                        <GridViewColumn Header="File" Width="220" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeBytes, StringFormat={}{0:N0}}"/>
                                        <GridViewColumn Header="Uploaded" Width="100" DisplayMemberBinding="{Binding Uploaded}"/>
                                        <GridViewColumn Header="Active" Width="60" DisplayMemberBinding="{Binding Active}"/>
                                        <GridViewColumn Header="Comment" Width="260" DisplayMemberBinding="{Binding Comment}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Device ================= -->
    <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Device" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Connect over USB/JTAG or Ethernet, control the machine and manage its SD card remotely."/>
                <Expander Header="How to use this page" Style="{StaticResource PageHelp}">
                    <StackPanel Margin="24,6,0,0" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Connection"/><Run Text=" – Pick the USB/JTAG COM port and press Connect, or find the MEGA65 on your network with Ethernet. Most features need USB/JTAG."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Reset, C64, MEGA65"/><Run Text=" – Restart the machine, or restart it straight into C64 or MEGA65 mode. Anything unsaved in memory is lost."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Camera button"/><Run Text=" – Saves a picture of the MEGA65's screen as a PNG file."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Drop a file to send it"/><Run Text=" – Drag a program (.prg) here, or press Choose, to load it into the MEGA65. Tick Run to start it; tick C64 program for C64 software."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="SID tune"/><Run Text=" – Plays a C64 music file (.sid). The MEGA65 switches to C64 mode; keys 1–9 on the MEGA65 pick the song."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="BASIC text"/><Run Text=" – Types a BASIC listing saved as text (.bas/.txt) into the MEGA65, as if you typed it yourself."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="ROM (temp)"/><Run Text=" – Starts the MEGA65 with a ROM file from this PC, to try it out. Your SD card is not changed; switching off brings back your normal ROM."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Bitstream"/><Run Text=" – Loads a core (.bit) into the FPGA until you switch off, without touching flash. Needs the WinUSB driver on the adapter's JTAG side."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="HICKUP"/><Run Text=" – Loads a different hypervisor (HICKUP.M65) until the next reset. Mainly for developers."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="PAL / NTSC"/><Run Text=" – Switches the video mode. Your screen may go blank for a moment while it re-syncs."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Start slot"/><Run Text=" – Restarts the MEGA65 from a core already stored in one of its flash slots. Nothing is written to flash."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Run hardware self-test"/><Run Text=" – Checks that connecting, typing, loading programs and the SD card all work. It leaves the machine as it found it."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Run unit tests"/><Run Text=" – For programmers: runs a test program that reports its results to the PC (the official m65 unit-test mode) and shows how many tests passed or failed. A log is saved in the reports folder."/></TextBlock>
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="PRG autoload"/><Run Text=" – For programmers: choose a folder and press Watch, and every .prg you build there is sent to the MEGA65 and run straight away."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Remote SD card"/><Run Text=" – Type mega65_ftp commands (dir, get, put…) for the card inside the MEGA65. The SD Card Browser does the same with buttons."/></TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
            <!-- Shown until the official tools are installed -->
            <Border DockPanel.Dock="Top" CornerRadius="6" Padding="12,10" Margin="0,0,0,10" BorderThickness="1"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Visibility="{Binding ToolsMissing, Converter={StaticResource BoolToVisible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Command="{Binding InstallToolsCommand}"
                            IsEnabled="{Binding InstallingTools, Converter={StaticResource Not}}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Install device tools"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,12,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Device tools needed" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Connecting to your MEGA65 uses the official command-line tools (m65, mega65_ftp, etherload). One click downloads them from the Filehost."/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Connection" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="USB/JTAG" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Command="{Binding RefreshPortsCommand}" ToolTip="Refresh ports" Margin="0,0,6,0">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                                    </Button>
                                    <Button Grid.Column="3" Content="Connect" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ConnectSerialCommand}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Ethernet" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding EthernetDevices}" SelectedItem="{Binding SelectedEthernet}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="Find" Command="{Binding DiscoverEthernetCommand}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="3" Content="Use" Command="{Binding ConnectEthernetCommand}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Ethernet needs core 0.96+, DIP switch 2 ON and SHIFT+£ pressed on the MEGA65 (the power LED blinks green/yellow). This PC needs IPv6 on its network adapter."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding DeviceText}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsConnected}">
                            <StackPanel>
                                <TextBlock Text="Control" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                    <Button HorizontalAlignment="Stretch" Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,4,0"/>
                                    <Button HorizontalAlignment="Stretch" Content="C64" Command="{Binding GoC64Command}" Margin="2,0" ToolTip="Switch to C64 mode"/>
                                    <Button HorizontalAlignment="Stretch" Content="MEGA65" Command="{Binding GoMega65Command}" Margin="2,0" ToolTip="Switch to MEGA65 mode"/>
                                    <Button HorizontalAlignment="Stretch" Command="{Binding ScreenshotCommand}" Margin="4,0,0,0" ToolTip="Screenshot (USB/JTAG)">
                                        <TextBlock Text="&#xE722;" Style="{StaticResource Icon}"/>
                                    </Button>
                                </UniformGrid>
                                <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" CornerRadius="6"
                                        Padding="10" AllowDrop="True" Background="{DynamicResource SubtleFillColorTransparentBrush}" v:DropTarget.Command="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Drop a file to send it" ToolTip="PRG, SID, BASIC text, ROM, BIT or HICKUP.M65"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <CheckBox Content="Run" IsChecked="{Binding RunAfterLoad}" Margin="0,0,12,0" MinWidth="0"/>
                                                <CheckBox Content="C64 program" IsChecked="{Binding C64Mode}" MinWidth="0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Choose…" Command="{Binding SendPrgCommand}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsConnected}">
                            <StackPanel>
                                <TextBlock Text="Load and run" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Button Content="SID tune" Command="{Binding SendSidCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,4" ToolTip="Play a .sid file (USB/JTAG)"/>
                                    <Button Content="BASIC text" Command="{Binding TypeBasicCommand}" HorizontalAlignment="Stretch" Margin="2,0,2,4" ToolTip="Type a BASIC listing (.bas/.txt) into the MEGA65 (USB/JTAG)"/>
                                    <Button Content="ROM (temp)" Command="{Binding LoadRomCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,4" ToolTip="Start with a ROM from this PC until power-off"/>
                                    <Button Content="Bitstream" Command="{Binding LoadBitCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" ToolTip="Load a .bit core until power-off (USB/JTAG)"/>
                                    <Button Content="HICKUP" Command="{Binding LoadHickupCommand}" HorizontalAlignment="Stretch" Margin="2,0,2,0" ToolTip="Replace the hypervisor until reset (USB/JTAG)"/>
                                    <UniformGrid Columns="2" Margin="4,0,0,0">
                                        <Button Content="PAL" Command="{Binding SetPalCommand}" HorizontalAlignment="Stretch" Margin="0,0,2,0"/>
                                        <Button Content="NTSC" Command="{Binding SetNtscCommand}" HorizontalAlignment="Stretch" Margin="2,0,0,0"/>
                                    </UniformGrid>
                                </UniformGrid>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Flash slot" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="Start slot" Command="{Binding BootSlotCommand}" ToolTip="Restart the FPGA from a core already in flash (nothing is written)"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Run hardware self-test" Command="{Binding SelfTestCommand}" Margin="0,0,6,0"
                                            ToolTip="Checks reset, BASIC typing, remote keyboard, PRG, C64/MEGA65 modes and the SD card on your MEGA65"/>
                                    <Button Content="Run unit tests…" Command="{Binding RunUnitTestCommand}"
                                            ToolTip="For programmers: run a test program that reports PASS/FAIL results through $D643 (m65 unit-test mode)"/>
                                </StackPanel>
                                <TextBlock Text="PRG autoload" Style="{StaticResource SectionTitle}" Margin="0,4,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AutoloadFolder, TargetNullValue='No folder chosen'}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <Button Grid.Column="1" Content="Folder…" Command="{Binding BrowseAutoloadCommand}" Margin="6,0"/>
                                    <ToggleButton Grid.Column="2" Content="Watch" IsChecked="{Binding AutoloadEnabled}" ToolTip="Send each .prg to the MEGA65 as soon as it changes (for example after building it)"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Remote SD card · mega65_ftp" Style="{StaticResource SectionTitle}"/>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8" IsEnabled="{Binding IsConnected}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SdCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" Margin="0,0,6,0"
                                     ToolTip="e.g. dir, get FILE.PRG, put C:\path\file.prg, mkdir NAME, rename A B, del FILE"/>
                            <Button Grid.Column="1" Content="Run" Command="{Binding RunSdCommandCommand}"/>
                        </Grid>
                        <Border CornerRadius="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Padding="6">
                            <ListBox ItemsSource="{Binding Output}" FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="2,0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="2,0"/></ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!-- ================= SD card browser ================= -->
    <DataTemplate DataType="{x:Type vm:CardBrowserViewModel}">
        <v:CardBrowserView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TerminalViewModel}">
        <v:TerminalView/>
    </DataTemplate>

    <!-- ================= SD card sync ================= -->
    <DataTemplate DataType="{x:Type vm:SdSyncViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="SD Card Sync" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Compare any package or folder with your card. Only approved files are written; replaced files are backed up; nothing is deleted."/>
                <Expander Header="How to use this page" Style="{StaticResource PageHelp}">
                    <StackPanel Margin="24,6,0,0" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="What it does"/><Run Text=" – Copies a set of files (for example a release package or a game collection) onto an SD card in this PC's card reader, only changing what is different."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Package"/><Run Text=" – The files you want on the card: a downloaded .7z/.zip archive, or a folder."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="SD card"/><Run Text=" – The card in this PC's card reader."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Compare"/><Run Text=" – Lists every file as new, changed or the same. Nothing is written yet."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Eject"/><Run Text=" – Safely ejects the card from the card reader when you are done, so it can go back into the MEGA65."/></TextBlock>
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Review and apply"/><Run Text=" – Shows the changes for approval, backs up any file that will be replaced, then copies. Files are never deleted from the card."/></TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Package" Style="{StaticResource Label}"/>
                    <TextBox Grid.Column="1" Text="{Binding PackagePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Archive…" Command="{Binding BrowsePackageFileCommand}" Margin="0,0,6,0"/>
                        <Button Content="Folder…" Command="{Binding BrowsePackageFolderCommand}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="SD card" Style="{StaticResource Label}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SdCardPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Browse…" Command="{Binding BrowseSdCardCommand}" Margin="0,0,6,0"/>
                        <Button Content="Eject" Command="{Binding EjectCardCommand}" ToolTip="Safely eject the SD card from this PC's card reader"/>
                    </StackPanel>
                    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Compare" Command="{Binding CompareCommand}" Margin="0,0,6,0"/>
                            <Button Content="Review and apply…" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"/>
                        </StackPanel>
                        <CheckBox Content="Hide unchanged" IsChecked="{Binding HideUnchanged}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </Border>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Margin="2,0,0,6" FontSize="12"/>
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Warnings}" Margin="2,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" FontSize="12"/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Padding="2" Margin="0">
                <ListView ItemContainerStyle="{StaticResource CompactRow}" ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Action" Width="95">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Action, Converter={StaticResource EnumLabel}}" Foreground="{Binding Action, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="File" Width="400" DisplayMemberBinding="{Binding RelativePath}"/>
                            <GridViewColumn Header="Package" Width="100" DisplayMemberBinding="{Binding PackageSize, StringFormat={}{0:N0}}"/>
                            <GridViewColumn Header="Card" Width="100" DisplayMemberBinding="{Binding TargetSize, StringFormat={}{0:N0}}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Disk & ROM tools ================= -->
    <DataTemplate DataType="{x:Type vm:ToolsPageViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Disk &amp; ROM Tools" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Work with D81 disk images, ROM files and core files on this PC. No MEGA65 connection is needed."/>
                <Expander Header="How to use this page" Style="{StaticResource PageHelp}">
                    <StackPanel Margin="24,6,0,0" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="D81 disk image"/><Run Text=' – A .D81 file is a virtual 3.5" floppy disk. Create one, put programs from your PC on it, or take files off it. Copy it to the SD card and mount it on the MEGA65 to use it like a real disk.'/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="ROM start-up settings"/><Run Text=" – The MEGA65 ROM remembers a few start-up choices: CPU speed, font and screen colours. Open a copy of your MEGA65.ROM, change them and save a new ROM file."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="ROM patch (.rdf)"/><Run Text=" – Some ROM changes are shared as small patch files instead of whole ROMs. Choose the patch and your ROM, and a patched copy is saved. Your original ROM is never changed."/></TextBlock>
                        <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Core file (.cor)"/><Run Text=" – Check that a core file is complete and undamaged before flashing it, or build a .cor from a .bit bitstream (for core developers)."/></TextBlock>
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Using the results"/><Run Text=" – Copy a new disk or ROM to the SD card with the SD Card Browser. To try a ROM without copying it, use ROM (temp) on the Device page."/></TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
            <TabControl>
                <TabItem Header="D81 disk image">
                    <DockPanel Margin="0,10,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="New…" Command="{Binding NewDiskCommand}" Margin="0,0,6,6"/>
                            <Button Content="Open…" Command="{Binding OpenDiskCommand}" Margin="0,0,6,6"/>
                            <Button Content="Save" Command="{Binding SaveDiskCommand}" IsEnabled="{Binding HasDisk}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,18,6"/>
                            <Button Content="Add files…" Command="{Binding AddFilesCommand}" IsEnabled="{Binding HasDisk}" Margin="0,0,6,6"/>
                            <Button Content="Extract…" Command="{Binding ExtractFilesCommand}" CommandParameter="{Binding SelectedItems, ElementName=DiskList}" IsEnabled="{Binding HasDisk}" Margin="0,0,6,6"/>
                            <Button Content="Rename" Command="{Binding RenameFileCommand}" CommandParameter="{Binding SelectedItems, ElementName=DiskList}" IsEnabled="{Binding HasDisk}" Margin="0,0,6,6"/>
                            <Button Content="Delete" Command="{Binding DeleteFilesCommand}" CommandParameter="{Binding SelectedItems, ElementName=DiskList}" IsEnabled="{Binding HasDisk}" Margin="0,0,6,6"/>
                        </WrapPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8" IsEnabled="{Binding HasDisk}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Disk name" Style="{StaticResource Label}"/>
                            <TextBox Grid.Column="1" Text="{Binding DiskName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" CharacterCasing="Upper"/>
                            <TextBlock Grid.Column="2" Text="ID" Style="{StaticResource Label}" Margin="12,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding DiskId, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" CharacterCasing="Upper"/>
                            <TextBlock Grid.Column="4" Text="{Binding DiskInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <Border Style="{StaticResource Card}" Padding="2" Margin="0">
                            <ListView x:Name="DiskList" ItemsSource="{Binding DiskEntries}" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                                      ItemContainerStyle="{StaticResource CompactRow}" FontFamily="Cascadia Mono, Consolas">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Blocks" Width="70" DisplayMemberBinding="{Binding Blocks}"/>
                                        <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Type" Width="70" DisplayMemberBinding="{Binding TypeName}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </DockPanel>
                </TabItem>
                <TabItem Header="ROM start-up settings">
                    <StackPanel Margin="0,10,0,0" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Open ROM…" Command="{Binding OpenRomCommand}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding RomInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding HasRom}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="CPU speed" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}" DisplayMemberPath="Label" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Text="Font" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Fonts}" SelectedItem="{Binding Font}" DisplayMemberPath="Label" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="2" Text="Text colour" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TextColours}" SelectedItem="{Binding Foreground}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Text="Border" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AreaColours}" SelectedItem="{Binding Border}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="4" Text="Background" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AreaColours}" SelectedItem="{Binding Background}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="5" Text="Error messages" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding TextColours}" SelectedItem="{Binding ErrorColour}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="6" Text="REM lines" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding TextColours}" SelectedItem="{Binding RemarkColour}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="7" Text="Keywords" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding TextColours}" SelectedItem="{Binding KeywordColour}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <Button Grid.Row="8" Grid.Column="1" Content="Save as…" Style="{DynamicResource AccentButtonStyle}" Command="{Binding SaveRomCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Muted}" Text="Your original ROM is never changed; the result is saved as a new file."/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="ROM patch (.rdf)">
                    <StackPanel Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding PatchInfo}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Patch" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                            <TextBlock Grid.Column="1" Text="{Binding PatchPath, TargetNullValue='none'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                            <Button Grid.Column="2" Content="Choose…" Command="{Binding OpenPatchCommand}" Margin="8,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="Base ROM" Style="{StaticResource Label}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PatchBasePath, TargetNullValue='none'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Choose…" Command="{Binding ChoosePatchBaseCommand}" Margin="8,0,0,0"/>
                        </Grid>
                        <Button Content="Apply patch and save…" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ApplyPatchCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Core file (.cor)">
                    <StackPanel Margin="0,10,0,0" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabIntro}" Text="A .cor file is a MEGA65 core (the FPGA design) packaged for installing into a flash slot with MEGAFLASH. Check that a .cor file is complete and undamaged before you flash it, or build one from a .bit bitstream."/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Check a core file" Style="{StaticResource SectionTitle}"/>
                                <Button Content="Choose .cor file…" Command="{Binding VerifyCoreCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CoreReport}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="3" Text="Build a core file from a bitstream" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Grid.Row="1" Text="Bitstream" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CoreBitPath, TargetNullValue='none'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Choose .bit…" Command="{Binding ChooseCoreBitCommand}" Margin="8,0,0,6"/>
                                <TextBlock Grid.Row="2" Text="For model" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CoreTargets}" SelectedItem="{Binding CoreTarget}" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="3" Text="Core name" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CoreName, UpdateSourceTrigger=PropertyChanged}" MaxLength="31" Margin="0,0,0,6" ToolTip="Shown in MEGAFLASH's slot list"/>
                                <TextBlock Grid.Row="4" Text="Version" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CoreVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="31" Margin="0,0,0,6"/>
                                <Button Grid.Row="5" Grid.Column="1" Content="Build and save .cor…" Style="{DynamicResource AccentButtonStyle}" Command="{Binding BuildCoreCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Muted}" Text="Building uses the official bit2core tool. Nothing is flashed: install the core on the MEGA65 with MEGAFLASH."/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DataTemplate>

    <!-- ================= About ================= -->
    <DataTemplate DataType="{x:Type vm:AboutViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <Image Source="/Assets/logo.png" Height="110" HorizontalAlignment="Left" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="About" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}">
                    <Run Text="Version"/> <Run Text="{Binding Version, Mode=OneWay}"/>
                </TextBlock>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Created by Chris Freeman" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="A Windows app for maintaining, updating and using a MEGA65: Filehost downloads, guided updates, SD card management and device control."/>
                        <TextBlock Text="Support and issues" Style="{StaticResource SectionTitle}"/>
                        <Button Style="{StaticResource FlatRow}" Command="{Binding OpenCommand}" CommandParameter="https://github.com/freemchr/mega65gui/issues" HorizontalAlignment="Left" Padding="0">
                        <TextBlock Text="Report a problem or request a feature (GitHub Issues)" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"/>
                    </Button>
                        <Button Style="{StaticResource FlatRow}" Command="{Binding OpenCommand}" CommandParameter="https://github.com/freemchr/mega65gui" HorizontalAlignment="Left" Padding="0">
                        <TextBlock Text="Source code and documentation: github.com/freemchr/mega65gui" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"/>
                    </Button>
                        <TextBlock Text="Support the project" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="MEGA65 GUI is free. If it helps you, you can buy me a coffee."/>
                        <Button Style="{StaticResource FlatRow}" Command="{Binding OpenCommand}" CommandParameter="https://buymeacoffee.com/cjf077" HorizontalAlignment="Left" Padding="0">
                        <TextBlock Text="&#x2615; Buy me a coffee: buymeacoffee.com/cjf077" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"/>
                    </Button>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Built with" Style="{StaticResource SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="The official MEGA65 tools (m65, mega65_ftp, etherload, romdiff) by the MEGA65 project, free software under the GNU GPL v3. MEGA65 GUI downloads them from the Filehost and runs them as separate programs."/>
                        <Button Style="{StaticResource FlatRow}" Command="{Binding OpenCommand}" CommandParameter="https://github.com/MEGA65/mega65-tools" HorizontalAlignment="Left" Padding="0">
                        <TextBlock Text="MEGA65 tools on GitHub" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"/>
                    </Button>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,8"
                                   Text="Releases, ROMs and software come from the MEGA65 Filehost. M65Connect's documentation was used as a reference for features; no M65Connect code is included."/>
                        <Button Style="{StaticResource FlatRow}" Command="{Binding OpenCommand}" CommandParameter="https://files.mega65.org" HorizontalAlignment="Left" Padding="0">
                        <TextBlock Text="MEGA65 Filehost" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"/>
                    </Button>
                        <Button Style="{StaticResource FlatRow}" Command="{Binding OpenCommand}" CommandParameter="https://mega65.org" HorizontalAlignment="Left" Padding="0">
                        <TextBlock Text="MEGA65 project" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"/>
                    </Button>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Muted}"
                                   Text="Also uses SharpCompress, CommunityToolkit.Mvvm and .NET (MIT licence). MEGA65 GUI is free software under the GNU GPL v3, an independent project and not an official MEGA65 product."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================= Tools ================= -->
    <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
        <StackPanel>
            <TextBlock Text="Device Tools" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="The official MEGA65 command-line tools the Device page uses to talk to your MEGA65, downloaded from the Filehost."/>
            <Expander Header="How to use this page" Style="{StaticResource PageHelp}">
                <StackPanel Margin="24,6,0,0" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Why they are needed"/><Run Text=" – MEGA65 GUI talks to the MEGA65 through the official MEGA65 tools (m65, mega65_ftp, etherload). They are downloaded once from the Filehost."/></TextBlock>
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Install device tools"/><Run Text=" – Downloads the recommended (development) build, which has the newest fixes."/></TextBlock>
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Install 1.00 release instead"/><Run Text=" – The older stable release. Some features, such as deleting folders on the card, do not work with it."/></TextBlock>
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Use existing folder"/><Run Text=" – Use tools you already have on this PC instead of downloading them."/></TextBlock>
                </StackPanel>
            </Expander>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding InstalledText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Content="Install device tools (recommended)" Style="{DynamicResource AccentButtonStyle}" Command="{Binding InstallDevelopmentCommand}" Margin="0,0,6,6"
                                ToolTip="The current development build. It includes etherload, which Ethernet features need."/>
                        <Button Content="Install 1.00 release instead" Command="{Binding InstallReleaseCommand}" Margin="0,0,6,6"
                                ToolTip="The stable 1.00 release (August 2024). Older, but includes the same tools."/>
                        <Button Content="Use existing folder…" Command="{Binding UseFolderCommand}" Margin="0,0,6,6"/>
                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Executables}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Muted}" Text="The MEGA65 tools are free software under the GNU GPL v3 (github.com/MEGA65/mega65-tools). MEGA65 GUI downloads the official builds and runs them as separate programs."/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ================= Features ================= -->
    <DataTemplate DataType="{x:Type vm:FeaturesViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Features" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="What MEGA65 GUI can do today, what still needs testing on a real MEGA65, and what is still to come."/>
                <!-- Summary tiles -->
                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="14,10" MinWidth="150">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,10,0"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Count}" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Count, StringFormat=' ({0})'}" FontSize="15" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="24,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3" ToolTip="{Binding Mechanism, StringFormat='How: {0}'}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DataContext.Glyph, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Style="{StaticResource Icon}" FontSize="12"
                                                               VerticalAlignment="Top" Margin="0,3,0,0"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}" FontSize="11.5"
                                                                   Visibility="{Binding Notes, Converter={StaticResource NullToCollapsed}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                                        <Border CornerRadius="4" Padding="6,1" Margin="0,0,4,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                            <TextBlock Text="{Binding Area}" FontSize="11"/>
                                                        </Border>
                                                        <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                            <TextBlock Text="{Binding Connection}" FontSize="11"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
