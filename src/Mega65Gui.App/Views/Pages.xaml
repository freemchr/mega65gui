<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Mega65Gui.App.ViewModels"
                    xmlns:v="clr-namespace:Mega65Gui.App.Views">

    <!-- Busy bar + status line shared by every page -->
    <DataTemplate x:Key="StatusFooter">
        <StackPanel Margin="0,6,0,0">
            <ProgressBar IsIndeterminate="True" Height="2" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ================= Update My MEGA65 ================= -->
    <DataTemplate DataType="{x:Type vm:UpdateViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Update My MEGA65" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Finds the right official release, updates your SD card with your approval, backs up what it replaces and guides the core install."/>
            </StackPanel>
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Model" Style="{StaticResource Label}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Label"/>
                    <TextBlock Grid.Column="3" Text="SD card" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Column="4" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="In the MEGA65" IsChecked="{Binding CardInDevice}" Margin="0,0,16,0" MinWidth="0"
                                     ToolTip="Update the card inside the MEGA65 over the USB/JTAG or Ethernet connection. The MEGA65 resets after each card operation."/>
                        <RadioButton Content="In a PC card reader" IsChecked="{Binding CardInDevice, Converter={StaticResource Not}}" MinWidth="0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.ColumnSpan="6" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CardInDevice}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBox Text="{Binding SdCardPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" ToolTip="The card's drive or a folder with a copy of it"/>
                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseSdCardCommand}"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="6" Margin="0,8,0,0" Style="{StaticResource Muted}"
                               Text="The card inside the MEGA65 is updated over the connection: its files are backed up to this PC first, only approved changes are uploaded, and every upload is read back and checked."
                               Visibility="{Binding CardInDevice, Converter={StaticResource BoolToVisible}}"/>

                    <DockPanel Grid.Row="2" Grid.ColumnSpan="6" Margin="0,8,0,0">
                        <!-- Inline connect when not connected -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                            <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" MinWidth="100" Margin="0,0,6,0"
                                      ToolTip="The MEGA65's USB/JTAG port"/>
                            <Button Command="{Binding RefreshPortsCommand}" ToolTip="Refresh ports" Margin="0,0,6,0">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                            </Button>
                            <Button Content="Connect" Command="{Binding ConnectCommand}"/>
                        </StackPanel>
                        <Ellipse VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource Dot}">
                                    <Setter Property="Fill" Value="#8A8A8A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource M65Green}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Grid.Row="3" Grid.ColumnSpan="6" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Open report" Command="{Binding OpenReportCommand}" Margin="0,0,6,0"
                                    Visibility="{Binding ReportPath, Converter={StaticResource NullToCollapsed}}"/>
                            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>
                            <Button Style="{DynamicResource AccentButtonStyle}" Padding="16,5"
                                    Command="{Binding RunCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="Update My MEGA65" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding IncludeRom}" VerticalAlignment="Center">
                            <TextBlock TextWrapping="Wrap">Include the closed MEGA65 ROM <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Text="(needs Filehost sign-in and your redeemed ownership code)"/></TextBlock>
                        </CheckBox>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="6" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- Right margin keeps the status labels clear of the overlay scrollbar -->
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,16,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top" HorizontalAlignment="Left"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                        <TextBlock Text="{Binding Number}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,1,0,0"
                                                   Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Status, Converter={StaticResource EnumLabel}}" FontSize="12"
                                               VerticalAlignment="Top" Margin="12,1,4,0"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Filehost catalogue ================= -->
    <DataTemplate DataType="{x:Type vm:CatalogueViewModel}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Filehost" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding CacheInfo}" Style="{StaticResource Muted}"/>
                </StackPanel>
                <Grid Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="28,4,8,4" ToolTip="Search titles, authors and tags"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="10,0,0,0" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="3" Content="Official" IsChecked="{Binding OfficialOnly}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Grid.Column="4" Command="{Binding RefreshCommand}" CommandParameter="{x:Static vm:Flags.True}" ToolTip="Refresh from the Filehost" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                </Button>
            </Grid>
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="11*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="9*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="2" Margin="0">
                    <ListView ItemContainerStyle="{StaticResource CompactRow}" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedFile}" BorderThickness="0" Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Title" Width="182">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Category" Width="80" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Author" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Author}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Updated" Width="82" DisplayMemberBinding="{Binding Updated, StringFormat=d}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding ViewingFileId, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="Select a file to see details and versions" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <DockPanel Visibility="{Binding ViewingFileId, Converter={StaticResource NullToCollapsed}}">
                            <!-- Actions pinned to the bottom of the pane -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <ProgressBar Value="{Binding DownloadPercent}" Height="2" Maximum="100" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding DownloadCommand}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Download"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Show in folder" Command="{Binding ShowInFolderCommand}" Margin="0,0,6,0"
                                            Visibility="{Binding SelectedVersion.CachedPath, Converter={StaticResource NullToCollapsed}}"/>
                                    <Button Content="Open on website" Command="{Binding OpenOnWebsiteCommand}"/>
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Detail.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,8"
                                               Visibility="{Binding Detail.IsAvailable, Converter={StaticResource BoolToVisible}}">
                                        <Run Text="{Binding Detail.Category}"/> · <Run Text="{Binding Detail.Type}"/> · <Run Text="{Binding Detail.Author}"/> · <Run Text="{Binding Detail.Downloads}"/> downloads
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail.PlainDescription}" TextWrapping="Wrap" FontSize="12.5" MaxHeight="220"/>

                                    <StackPanel Visibility="{Binding LinkedFiles.Count, Converter={StaticResource NullToCollapsed}}" Margin="0,10,0,0">
                                        <TextBlock Text="Linked files" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding LinkedFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button HorizontalAlignment="Left" Margin="0,0,0,4"
                                                            Command="{Binding DataContext.OpenLinkedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding Versions.Count, Converter={StaticResource NullToCollapsed}}" Margin="0,10,0,0">
                                        <TextBlock Text="Versions" Style="{StaticResource SectionTitle}"/>
                                        <ListView ItemContainerStyle="{StaticResource CompactRow}" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" MaxHeight="200">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Release" Width="70" DisplayMemberBinding="{Binding Release}"/>
                                                    <GridViewColumn Header="File" Width="185">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate><TextBlock Text="{Binding Row.FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Row.FileName}"/></DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Published" Width="88" DisplayMemberBinding="{Binding Row.Published}"/>
                                                    <GridViewColumn Header="" Width="28">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource M65Green}" ToolTip="Current version">
                                                                    <TextBlock.Visibility>
                                                                        <Binding Path="Row.IsActive" Converter="{StaticResource BoolToVisible}"/>
                                                                    </TextBlock.Visibility>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <TextBlock Text="{Binding SelectedVersion.Row.Comment}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Device ================= -->
    <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Device" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Connect over USB/JTAG or Ethernet, control the machine and manage its SD card remotely."/>
            </StackPanel>
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
            <!-- Shown until the official tools are installed -->
            <Border DockPanel.Dock="Top" CornerRadius="6" Padding="12,10" Margin="0,0,0,10" BorderThickness="1"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Visibility="{Binding ToolsMissing, Converter={StaticResource BoolToVisible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Command="{Binding InstallToolsCommand}"
                            IsEnabled="{Binding InstallingTools, Converter={StaticResource Not}}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Install device tools"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,12,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Device tools needed" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Connecting to your MEGA65 uses the official command-line tools (m65, mega65_ftp, etherload). One click downloads them from the Filehost."/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Connection" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="USB/JTAG" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Command="{Binding RefreshPortsCommand}" ToolTip="Refresh ports" Margin="0,0,6,0">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                                    </Button>
                                    <Button Grid.Column="3" Content="Connect" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ConnectSerialCommand}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Ethernet" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding EthernetDevices}" SelectedItem="{Binding SelectedEthernet}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="Find" Command="{Binding DiscoverEthernetCommand}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="3" Content="Use" Command="{Binding ConnectEthernetCommand}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Ethernet needs core 0.96+. Press SHIFT+£ on the MEGA65 first."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding DeviceText}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsConnected}">
                            <StackPanel>
                                <TextBlock Text="Control" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                    <Button HorizontalAlignment="Stretch" Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,4,0"/>
                                    <Button HorizontalAlignment="Stretch" Content="C64" Command="{Binding GoC64Command}" Margin="2,0" ToolTip="Switch to C64 mode"/>
                                    <Button HorizontalAlignment="Stretch" Content="MEGA65" Command="{Binding GoMega65Command}" Margin="2,0" ToolTip="Switch to MEGA65 mode"/>
                                    <Button HorizontalAlignment="Stretch" Command="{Binding ScreenshotCommand}" Margin="4,0,0,0" ToolTip="Screenshot (USB/JTAG)">
                                        <TextBlock Text="&#xE722;" Style="{StaticResource Icon}"/>
                                    </Button>
                                </UniformGrid>
                                <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" CornerRadius="6"
                                        Padding="10" AllowDrop="True" Background="{DynamicResource SubtleFillColorTransparentBrush}" v:DropTarget.Command="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Drop a file to send it" ToolTip="PRG, SID, BASIC text, ROM, BIT or HICKUP.M65"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <CheckBox Content="Run" IsChecked="{Binding RunAfterLoad}" Margin="0,0,12,0" MinWidth="0"/>
                                                <CheckBox Content="C64 program" IsChecked="{Binding C64Mode}" MinWidth="0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Choose…" Command="{Binding SendPrgCommand}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsConnected}">
                            <StackPanel>
                                <TextBlock Text="Load and run" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Button Content="SID tune" Command="{Binding SendSidCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,4" ToolTip="Play a .sid file (USB/JTAG)"/>
                                    <Button Content="BASIC text" Command="{Binding TypeBasicCommand}" HorizontalAlignment="Stretch" Margin="2,0,2,4" ToolTip="Type a BASIC listing (.bas/.txt) into the MEGA65 (USB/JTAG)"/>
                                    <Button Content="ROM (temp)" Command="{Binding LoadRomCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,4" ToolTip="Start with a ROM from this PC until power-off"/>
                                    <Button Content="Bitstream" Command="{Binding LoadBitCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" ToolTip="Load a .bit core until power-off (USB/JTAG)"/>
                                    <Button Content="HICKUP" Command="{Binding LoadHickupCommand}" HorizontalAlignment="Stretch" Margin="2,0,2,0" ToolTip="Replace the hypervisor until reset (USB/JTAG)"/>
                                    <UniformGrid Columns="2" Margin="4,0,0,0">
                                        <Button Content="PAL" Command="{Binding SetPalCommand}" HorizontalAlignment="Stretch" Margin="0,0,2,0"/>
                                        <Button Content="NTSC" Command="{Binding SetNtscCommand}" HorizontalAlignment="Stretch" Margin="2,0,0,0"/>
                                    </UniformGrid>
                                </UniformGrid>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Flash slot" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="Start slot" Command="{Binding BootSlotCommand}" ToolTip="Restart the FPGA from a core already in flash (nothing is written)"/>
                                </Grid>
                                <Button Content="Run hardware self-test" Command="{Binding SelfTestCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        ToolTip="Checks reset, BASIC typing, remote keyboard, PRG, C64/MEGA65 modes and the SD card on your MEGA65"/>
                                <TextBlock Text="PRG autoload" Style="{StaticResource SectionTitle}" Margin="0,4,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AutoloadFolder, TargetNullValue='No folder chosen'}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <Button Grid.Column="1" Content="Folder…" Command="{Binding BrowseAutoloadCommand}" Margin="6,0"/>
                                    <ToggleButton Grid.Column="2" Content="Watch" IsChecked="{Binding AutoloadEnabled}" ToolTip="Send each .prg to the MEGA65 as soon as it changes (for example after building it)"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Remote SD card · mega65_ftp" Style="{StaticResource SectionTitle}"/>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8" IsEnabled="{Binding IsConnected}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SdCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" Margin="0,0,6,0"
                                     ToolTip="e.g. dir, get FILE.PRG, put C:\path\file.prg, mkdir NAME, rename A B, del FILE"/>
                            <Button Grid.Column="1" Content="Run" Command="{Binding RunSdCommandCommand}"/>
                        </Grid>
                        <Border CornerRadius="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Padding="6">
                            <ListBox ItemsSource="{Binding Output}" FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="2,0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="2,0"/></ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!-- ================= SD card browser ================= -->
    <DataTemplate DataType="{x:Type vm:CardBrowserViewModel}">
        <v:CardBrowserView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TerminalViewModel}">
        <v:TerminalView/>
    </DataTemplate>

    <!-- ================= SD card sync ================= -->
    <DataTemplate DataType="{x:Type vm:SdSyncViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="SD Card Sync" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Compare any package or folder with your card. Only approved files are written; replaced files are backed up; nothing is deleted."/>
            </StackPanel>
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Package" Style="{StaticResource Label}"/>
                    <TextBox Grid.Column="1" Text="{Binding PackagePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Archive…" Command="{Binding BrowsePackageFileCommand}" Margin="0,0,6,0"/>
                        <Button Content="Folder…" Command="{Binding BrowsePackageFolderCommand}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="SD card" Style="{StaticResource Label}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SdCardPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Command="{Binding BrowseSdCardCommand}" HorizontalAlignment="Left"/>
                    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Compare" Command="{Binding CompareCommand}" Margin="0,0,6,0"/>
                            <Button Content="Review and apply…" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"/>
                        </StackPanel>
                        <CheckBox Content="Hide unchanged" IsChecked="{Binding HideUnchanged}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </Border>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Margin="2,0,0,6" FontSize="12"/>
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Warnings}" Margin="2,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" FontSize="12"/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Padding="2" Margin="0">
                <ListView ItemContainerStyle="{StaticResource CompactRow}" ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Action" Width="95">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Action, Converter={StaticResource EnumLabel}}" Foreground="{Binding Action, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="File" Width="400" DisplayMemberBinding="{Binding RelativePath}"/>
                            <GridViewColumn Header="Package" Width="100" DisplayMemberBinding="{Binding PackageSize, StringFormat={}{0:N0}}"/>
                            <GridViewColumn Header="Card" Width="100" DisplayMemberBinding="{Binding TargetSize, StringFormat={}{0:N0}}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Disk & ROM tools ================= -->
    <DataTemplate DataType="{x:Type vm:ToolsPageViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Disk &amp; ROM Tools" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Work with D81 disk images and ROM files on this PC. No MEGA65 connection is needed."/>
            </StackPanel>
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
            <TabControl>
                <TabItem Header="D81 disk image">
                    <DockPanel Margin="0,10,0,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="New…" Command="{Binding NewDiskCommand}" Margin="0,0,6,6"/>
                            <Button Content="Open…" Command="{Binding OpenDiskCommand}" Margin="0,0,6,6"/>
                            <Button Content="Save" Command="{Binding SaveDiskCommand}" IsEnabled="{Binding HasDisk}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,18,6"/>
                            <Button Content="Add files…" Command="{Binding AddFilesCommand}" IsEnabled="{Binding HasDisk}" Margin="0,0,6,6"/>
                            <Button Content="Extract…" Command="{Binding ExtractFilesCommand}" CommandParameter="{Binding SelectedItems, ElementName=DiskList}" IsEnabled="{Binding HasDisk}" Margin="0,0,6,6"/>
                            <Button Content="Rename" Command="{Binding RenameFileCommand}" CommandParameter="{Binding SelectedItems, ElementName=DiskList}" IsEnabled="{Binding HasDisk}" Margin="0,0,6,6"/>
                            <Button Content="Delete" Command="{Binding DeleteFilesCommand}" CommandParameter="{Binding SelectedItems, ElementName=DiskList}" IsEnabled="{Binding HasDisk}" Margin="0,0,6,6"/>
                        </WrapPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8" IsEnabled="{Binding HasDisk}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Disk name" Style="{StaticResource Label}"/>
                            <TextBox Grid.Column="1" Text="{Binding DiskName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" CharacterCasing="Upper"/>
                            <TextBlock Grid.Column="2" Text="ID" Style="{StaticResource Label}" Margin="12,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding DiskId, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" CharacterCasing="Upper"/>
                            <TextBlock Grid.Column="4" Text="{Binding DiskInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <Border Style="{StaticResource Card}" Padding="2" Margin="0">
                            <ListView x:Name="DiskList" ItemsSource="{Binding DiskEntries}" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                                      ItemContainerStyle="{StaticResource CompactRow}" FontFamily="Cascadia Mono, Consolas">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Blocks" Width="70" DisplayMemberBinding="{Binding Blocks}"/>
                                        <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Type" Width="70" DisplayMemberBinding="{Binding TypeName}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </DockPanel>
                </TabItem>
                <TabItem Header="ROM start-up settings">
                    <StackPanel Margin="0,10,0,0" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Open ROM…" Command="{Binding OpenRomCommand}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding RomInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding HasRom}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="CPU speed" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}" DisplayMemberPath="Label" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Text="Font" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Fonts}" SelectedItem="{Binding Font}" DisplayMemberPath="Label" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="2" Text="Text colour" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TextColours}" SelectedItem="{Binding Foreground}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Text="Border" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AreaColours}" SelectedItem="{Binding Border}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="4" Text="Background" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AreaColours}" SelectedItem="{Binding Background}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="5" Text="Error messages" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding TextColours}" SelectedItem="{Binding ErrorColour}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="6" Text="REM lines" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding TextColours}" SelectedItem="{Binding RemarkColour}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="7" Text="Keywords" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                                <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding TextColours}" SelectedItem="{Binding KeywordColour}" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#80808080" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <Button Grid.Row="8" Grid.Column="1" Content="Save as…" Style="{DynamicResource AccentButtonStyle}" Command="{Binding SaveRomCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Muted}" Text="Your original ROM is never changed; the result is saved as a new file."/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="ROM patch (.rdf)">
                    <StackPanel Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding PatchInfo}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Patch" Style="{StaticResource Label}" Margin="0,0,10,6"/>
                            <TextBlock Grid.Column="1" Text="{Binding PatchPath, TargetNullValue='none'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                            <Button Grid.Column="2" Content="Choose…" Command="{Binding OpenPatchCommand}" Margin="8,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="Base ROM" Style="{StaticResource Label}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PatchBasePath, TargetNullValue='none'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Choose…" Command="{Binding ChoosePatchBaseCommand}" Margin="8,0,0,0"/>
                        </Grid>
                        <Button Content="Apply patch and save…" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ApplyPatchCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DataTemplate>

    <!-- ================= About ================= -->
    <DataTemplate DataType="{x:Type vm:AboutViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="About MEGA65 GUI" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}">
                    <Run Text="Version"/> <Run Text="{Binding Version, Mode=OneWay}"/>
                </TextBlock>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Created by Chris Freeman" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="A Windows app for maintaining, updating and using a MEGA65: Filehost downloads, guided updates, SD card management and device control."/>
                        <TextBlock Text="Support and issues" Style="{StaticResource SectionTitle}"/>
                        <Button Style="{StaticResource FlatRow}" Command="{Binding OpenCommand}" CommandParameter="https://github.com/freemchr/mega65gui/issues" HorizontalAlignment="Left" Padding="0">
                        <TextBlock Text="Report a problem or request a feature (GitHub Issues)" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"/>
                    </Button>
                        <Button Style="{StaticResource FlatRow}" Command="{Binding OpenCommand}" CommandParameter="https://github.com/freemchr/mega65gui" HorizontalAlignment="Left" Padding="0">
                        <TextBlock Text="Source code and documentation: github.com/freemchr/mega65gui" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"/>
                    </Button>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Built with" Style="{StaticResource SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="The official MEGA65 tools (m65, mega65_ftp, etherload, romdiff) by the MEGA65 project, free software under the GNU GPL v3. MEGA65 GUI downloads them from the Filehost and runs them as separate programs."/>
                        <Button Style="{StaticResource FlatRow}" Command="{Binding OpenCommand}" CommandParameter="https://github.com/MEGA65/mega65-tools" HorizontalAlignment="Left" Padding="0">
                        <TextBlock Text="MEGA65 tools on GitHub" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"/>
                    </Button>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,8"
                                   Text="Releases, ROMs and software come from the MEGA65 Filehost. M65Connect's documentation was used as a reference for features; no M65Connect code is included."/>
                        <Button Style="{StaticResource FlatRow}" Command="{Binding OpenCommand}" CommandParameter="https://files.mega65.org" HorizontalAlignment="Left" Padding="0">
                        <TextBlock Text="MEGA65 Filehost" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"/>
                    </Button>
                        <Button Style="{StaticResource FlatRow}" Command="{Binding OpenCommand}" CommandParameter="https://mega65.org" HorizontalAlignment="Left" Padding="0">
                        <TextBlock Text="MEGA65 project" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"/>
                    </Button>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Muted}"
                                   Text="Also uses SharpCompress, CommunityToolkit.Mvvm and .NET (MIT licence). MEGA65 GUI is an independent project and is not an official MEGA65 product."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================= Tools ================= -->
    <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
        <StackPanel>
            <TextBlock Text="Device Tools" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="The official MEGA65 command-line tools the Device page uses to talk to your MEGA65, downloaded from the Filehost."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding InstalledText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Content="Install device tools (recommended)" Style="{DynamicResource AccentButtonStyle}" Command="{Binding InstallDevelopmentCommand}" Margin="0,0,6,6"
                                ToolTip="The current development build. It includes etherload, which Ethernet features need."/>
                        <Button Content="Install 1.00 release instead" Command="{Binding InstallReleaseCommand}" Margin="0,0,6,6"
                                ToolTip="The stable 1.00 release (August 2024). Older, but includes the same tools."/>
                        <Button Content="Use existing folder…" Command="{Binding UseFolderCommand}" Margin="0,0,6,6"/>
                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Executables}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Muted}" Text="The MEGA65 tools are free software under the GNU GPL v3 (github.com/MEGA65/mega65-tools). MEGA65 GUI downloads the official builds and runs them as separate programs."/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ================= Features ================= -->
    <DataTemplate DataType="{x:Type vm:FeaturesViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Features" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Counts}" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="2" Margin="0">
                <ListView ItemContainerStyle="{StaticResource CompactRow}" ItemsSource="{Binding View}" BorderThickness="0" Background="Transparent">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="8,10,0,2"/></DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Feature" Width="350">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}" FontSize="11"
                                                       Visibility="{Binding Notes, Converter={StaticResource NullToCollapsed}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Status, Converter={StaticResource EnumLabel}}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" FontSize="12"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Connection" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Connection}" FontSize="12" TextWrapping="Wrap"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="How" Width="230">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Mechanism}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
