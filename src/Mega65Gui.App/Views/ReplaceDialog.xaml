<Window x:Class="Mega65Gui.App.Views.ReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replace file" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="This file is already there:" Margin="0,0,0,4"/>
        <TextBlock x:Name="What" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Replace" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Tag="Replace" Click="Choose" Margin="0,0,6,0"/>
            <Button Content="Skip" Tag="Skip" Click="Choose" Margin="0,0,6,0"/>
            <Button Content="Replace all" Tag="ReplaceAll" Click="Choose" Margin="0,0,6,0" ToolTip="Replace this and every other clash in this copy"/>
            <Button Content="Skip all" Tag="SkipAll" Click="Choose" Margin="0,0,6,0" ToolTip="Keep this and every other file that is already there"/>
            <Button Content="Cancel" IsCancel="True" Tag="Cancel" Click="Choose" ToolTip="Stop copying"/>
        </StackPanel>
    </StackPanel>
</Window>
