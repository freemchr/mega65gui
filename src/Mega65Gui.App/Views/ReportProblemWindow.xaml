<Window x:Class="Mega65Gui.App.Views.ReportProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report a problem" Width="620" Height="520" MinWidth="460" MinHeight="380" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Report a problem" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap"
                       Text="These details help work out what went wrong. Open GitHub issue starts a new report in your browser with them filled in: add what you were doing and what happened, then post it. Nothing is sent until you do."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                       Text="No passwords, tokens or account names are included. Your Windows user folder is shown as %USERPROFILE%. Posting needs a free GitHub account; without one, copy the details and send them another way."/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="Copied" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Button Content="Copy details" Click="Copy" Margin="0,0,8,0"/>
            <Button Content="Open GitHub issue" Click="OpenIssue" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Close" IsCancel="True"/>
        </StackPanel>
        <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True"/>
    </DockPanel>
</Window>
