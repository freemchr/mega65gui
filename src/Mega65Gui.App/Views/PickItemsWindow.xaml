<Window x:Class="Mega65Gui.App.Views.PickItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="480" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <DockPanel Margin="20">
        <TextBlock x:Name="Prompt" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Select all" Click="SelectAll" Margin="0,0,18,0"/>
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Ok"/>
        </StackPanel>
        <ListBox x:Name="Items" SelectionMode="Extended" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
    </DockPanel>
</Window>
