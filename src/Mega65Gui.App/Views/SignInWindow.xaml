<Window x:Class="Mega65Gui.App.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to the MEGA65 Filehost" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Sign in to files.mega65.org" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"
                   Text="Use your own Filehost account. Owner-only downloads, such as release packages with the closed ROM, appear once you have redeemed the ownership code that came with your MEGA65 on the Filehost website."/>
        <TextBlock Text="User name" Margin="0,0,0,4"/>
        <TextBox x:Name="UserBox" Margin="0,0,0,10"/>
        <TextBlock Text="Password" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10"/>
        <CheckBox x:Name="RememberBox" Content="Remember my password on this PC (encrypted for your Windows account)" Margin="0,0,0,10"/>
        <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" Margin="0,0,0,10"/>
        <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="SignInButton" Content="Sign in" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="SignIn"/>
        </StackPanel>
    </StackPanel>
</Window>
