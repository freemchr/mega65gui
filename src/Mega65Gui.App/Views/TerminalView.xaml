<UserControl x:Class="Mega65Gui.App.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Terminal and remote keyboard" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Talk to the MEGA65's serial monitor over USB/JTAG, or type on the MEGA65 from this PC's keyboard. The monitor can change memory; use it with care."/>
            <Expander Header="How to use this page" Style="{StaticResource PageHelp}">
                <StackPanel Margin="24,6,0,0" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Open"/><Run Text=" – Connects to the MEGA65's built-in serial monitor over USB/JTAG. The monitor replies to short commands; its prompt is a dot (.)."/></TextBlock>
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Useful commands"/><Run Text=" – h shows the core version · r shows the CPU registers · m 2001 shows memory from $2001 · d 2001 disassembles from $2001. Type a command in the box at the bottom and press Enter."/></TextBlock>
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Careful"/><Run Text=" – Some monitor commands change memory or stop the CPU. If the MEGA65 stops responding, press Reset on the Device page."/></TextBlock>
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Remote keyboard"/><Run Text=" – Turn it on, click the blue box and type: your keys are pressed on the MEGA65. Enter is RETURN, Esc is RUN/STOP, F1–F12 are the function keys. The buttons press keys a PC does not have (ESC, HELP, NO SCROLL, F13, F14 …); CTRL, MEGA and ALT are held for the next key you press."/></TextBlock>
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Developer"/><Run Text=" – Save a range of the MEGA65's memory to a file, or stop the CPU at an address (breakpoint), look at the registers, then clear it and continue."/></TextBlock>
                    <TextBlock Style="{StaticResource HelpLine}"><Run FontWeight="SemiBold" Text="Close"/><Run Text=" – Frees the USB connection for the other pages. It closes by itself when you leave this page."/></TextBlock>
                </StackPanel>
            </Expander>
        </StackPanel>
        <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusFooter}"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Open" Style="{DynamicResource AccentButtonStyle}" Command="{Binding OpenCommand}" Margin="0,0,6,0"
                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>
            <Button Content="Close" Command="{Binding DisconnectCommand}" Margin="0,0,6,0" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisible}}"/>
            <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,6,0"/>
            <Button Content="Save…" Command="{Binding SaveTranscriptCommand}" Margin="0,0,18,0" ToolTip="Save the terminal text to a file"/>
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsOpen}" Margin="0,0,18,0">
                <Button Content="Version" Command="{Binding QuickCommand}" CommandParameter="h" Margin="0,0,6,0" ToolTip="h: show the monitor and core version"/>
                <Button Content="Registers" Command="{Binding QuickCommand}" CommandParameter="r" Margin="0,0,6,0" ToolTip="r: show the CPU registers"/>
                <Button Content="BASIC memory" Command="{Binding QuickCommand}" CommandParameter="m2001" ToolTip="m2001: show memory where BASIC programs start ($2001)"/>
            </StackPanel>
            <ToggleButton x:Name="KeyboardToggle" IsChecked="{Binding KeyboardActive}" IsEnabled="{Binding IsOpen}" Checked="KeyboardOn"
                          ToolTip="While on, keys typed in the box below are pressed on the MEGA65">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                    <TextBlock Text="Remote keyboard"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>
        <!-- Developer tools -->
        <Expander DockPanel.Dock="Top" Header="Developer: memory dump and breakpoints" Margin="0,0,0,8" IsEnabled="{Binding IsOpen}">
            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Save memory from $" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding DumpStart, UpdateSourceTrigger=PropertyChanged}" Width="90" FontFamily="Cascadia Mono, Consolas" ToolTip="Start address in hex (up to 28 bits, e.g. 2001, 20000, FFD3000)"/>
                    <TextBlock Text="length $" Style="{StaticResource Label}" Margin="10,0,8,0"/>
                    <TextBox Text="{Binding DumpLength, UpdateSourceTrigger=PropertyChanged}" Width="80" FontFamily="Cascadia Mono, Consolas" ToolTip="Number of bytes in hex (up to 100000 = 1 MB). About 1.3 KB per second."/>
                    <Button Content="Save to file…" Command="{Binding DumpMemoryCommand}" Margin="10,0,0,0"/>
                    <ProgressBar Width="120" Height="4" Margin="10,0,0,0" Value="{Binding DumpProgress}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Breakpoint at $" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding BreakAddress, UpdateSourceTrigger=PropertyChanged}" Width="90" FontFamily="Cascadia Mono, Consolas" ToolTip="CPU address in hex (0000-FFFF)"/>
                    <Button Content="Set" Command="{Binding SetBreakpointCommand}" Margin="10,0,6,0" ToolTip="Stop the CPU when it reaches this address"/>
                    <Button Content="Clear and continue" Command="{Binding ContinueCommand}" ToolTip="Remove the breakpoint and let the CPU run again"/>
                </StackPanel>
            </StackPanel>
        </Expander>
        <!-- Remote keyboard capture -->
        <Border x:Name="KeyCapture" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,8" CornerRadius="6" Focusable="True"
                BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{Binding KeyboardActive, Converter={StaticResource BoolToVisible}}"
                PreviewKeyDown="CaptureKeyDown" TextInput="CaptureTextInput" MouseDown="CaptureClick">
            <StackPanel>
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="Typing goes to the MEGA65."/>
                    <Run Text="Click here to focus. Enter = RETURN, Backspace = INST/DEL, arrows, Home (Shift+Home = CLR), Esc = RUN/STOP, Tab = TAB, F1–F12, Scroll Lock = NO SCROLL. Ctrl or Alt with a letter or digit presses it with CTRL or ALT."/>
                </TextBlock>
                <!-- Keys a PC keyboard does not have. Focusable=False keeps the typing focus here. -->
                <WrapPanel Margin="0,8,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Margin" Value="0,0,4,4"/>
                            <Setter Property="Padding" Value="8,3"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Command" Value="{Binding PressKeyCommand}"/>
                        </Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Margin" Value="0,0,4,4"/>
                            <Setter Property="Padding" Value="8,3"/>
                            <Setter Property="MinWidth" Value="0"/>
                        </Style>
                    </WrapPanel.Resources>
                    <ToggleButton Content="CTRL" IsChecked="{Binding HoldCtrl}" ToolTip="Hold CTRL for the next key"/>
                    <ToggleButton Content="MEGA" IsChecked="{Binding HoldMega}" ToolTip="Hold the MEGA key for the next key"/>
                    <ToggleButton Content="ALT" IsChecked="{Binding HoldAlt}" ToolTip="Hold ALT for the next key" Margin="0,0,12,4"/>
                    <Button Content="RUN/STOP" CommandParameter="RunStop"/>
                    <Button Content="ESC" CommandParameter="Escape"/>
                    <Button Content="TAB" CommandParameter="Tab"/>
                    <Button Content="HELP" CommandParameter="Help"/>
                    <Button Content="NO SCROLL" CommandParameter="NoScroll"/>
                    <Button Content="CLR HOME" CommandParameter="Home"/>
                    <Button Content="↑" CommandParameter="UpArrow" ToolTip="The ↑ key (next to RESTORE)"/>
                    <Button Content="←" CommandParameter="LeftArrow" ToolTip="The ← key (next to 1)" Margin="0,0,12,4"/>
                    <Button Content="F9" CommandParameter="F9"/>
                    <Button Content="F10" CommandParameter="F10"/>
                    <Button Content="F11" CommandParameter="F11"/>
                    <Button Content="F12" CommandParameter="F12"/>
                    <Button Content="F13" CommandParameter="F13"/>
                    <Button Content="F14" CommandParameter="F14"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Muted}" Text="RESTORE, CAPS LOCK and 40/80 are wired separately from the keyboard matrix, so they cannot be pressed remotely."/>
            </StackPanel>
        </Border>
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" IsEnabled="{Binding IsOpen}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" KeyDown="CommandKeyDown"
                     ToolTip="Monitor command, e.g. h (version), r (registers), m2001 (memory), d2001 (disassemble). Press Enter to send."/>
            <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" Margin="6,0,0,0"/>
        </Grid>
        <Border CornerRadius="6" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <TextBox x:Name="Output" Text="{Binding Transcript, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     BorderThickness="0" Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
        </Border>
    </DockPanel>
</UserControl>
