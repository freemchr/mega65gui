<Window x:Class="Mega65Gui.App.Views.ChangeApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approve changes" Width="760" Height="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8">
            Only the ticked files will be written. Replaced files are backed up first. Files that exist only on your card are never touched.
        </TextBlock>
        <ItemsControl DockPanel.Dock="Top" x:Name="WarningList" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="Totals" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Button Content="Select all" Click="SelectAll" Margin="0,0,8,0"/>
            <Button Content="Select none" Click="SelectNone" Margin="0,0,24,0"/>
            <Button Content="Cancel" IsCancel="True" Click="Cancel" Margin="0,0,8,0"/>
            <Button Content="Apply selected" IsDefault="True" Click="Apply" Style="{DynamicResource AccentButtonStyle}"/>
        </StackPanel>
        <ListView x:Name="Items">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><CheckBox IsChecked="{Binding Selected}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Action" Width="90" DisplayMemberBinding="{Binding Item.Action}"/>
                    <GridViewColumn Header="File" Width="400" DisplayMemberBinding="{Binding Item.RelativePath}"/>
                    <GridViewColumn Header="Size" Width="120" DisplayMemberBinding="{Binding Item.PackageSize, StringFormat={}{0:N0}}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
